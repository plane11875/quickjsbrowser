{
  "name": "quickjsbrowser",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": true
    },
    {
      "type": "Text",
      "globs": [
        "**/*.iife.js"
      ],
      "fallthrough": true
    },
    {
      "type": "Data",
      "globs": [
        "**/*.ttf"
      ],
      "fallthrough": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QJS",
        "class_name": "QjsSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "QjsSession"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
