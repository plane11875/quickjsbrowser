{
  "name": "quickjsbrowser",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash scripts/fetch-engine.sh && bash engine/build.sh",
    "deploy": "wrangler deploy",
    "test:local": "node test/run-local.mjs",
    "build:renderer": "bash scripts/build-renderer.sh",
    "test": "node test/run-local.mjs && node test/renderer-regression.mjs",
    "test:renderer": "node test/renderer-regression.mjs",
    "test:remote": "node test/cdp-smoke.mjs"
  },
  "devDependencies": {
    "chrome-remote-interface": "^0.34.0",
    "global-agent": "^4.1.3",
    "puppeteer-core": "^25.13.0",
    "undici": "^8.11.2",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13"
  }
}
